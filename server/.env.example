PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
FRONTEND_URL=http://localhost:5173
JWT_SECRET=REPLACE_ME
JWT_EXPIRES_IN=1h

# Optional GitHub App integration. Configure all of these before using /api/github/connect.
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_CLIENT_ID=YOUR_GITHUB_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_APP_CLIENT_SECRET
GITHUB_PRIVATE_KEY=REPLACE_WITH_GITHUB_APP_PEM_PRIVATE_KEY
GITHUB_APP_SLUG=YOUR_GITHUB_APP_SLUG
GITHUB_CALLBACK_URL=https://your-api.example.com/api/github/callback
